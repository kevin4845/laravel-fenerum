{
    "name": "kevin4845/laravel-fenerum",
    "description": "PHP client for the Fenerum API, with an optional Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["fenerum", "billing", "subscriptions", "api", "laravel"],
    "authors": [
        {
            "name": "Kevin Møller Madsen",
            "email": "madsen070602@hotmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "orchestra/testbench": "^9.16 || ^10.8 || ^11.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "illuminate/support": "Required only for the optional Laravel service provider and facade. The integration tests in this package ran on Laravel 13."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kevin4845\\LaravelFenerum\\Laravel\\FenerumServiceProvider"
            ],
            "aliases": {
                "Fenerum": "Kevin4845\\LaravelFenerum\\Laravel\\Fenerum"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Kevin4845\\LaravelFenerum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kevin4845\\LaravelFenerum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpcs": "phpcs",
        "package-validate": "composer validate --no-check-publish --strict",
        "check": [
            "@package-validate",
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
