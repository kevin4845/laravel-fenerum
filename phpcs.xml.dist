<?xml version="1.0"?>
<ruleset name="kevin4845/laravel-fenerum">
    <description>PSR-12 checks for the Fenerum client.</description>
    <file>src</file>
    <file>tests</file>
    <arg name="colors"/>
    <arg value="p"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
